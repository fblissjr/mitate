# Scenes staged from the skill's examples/ at build time by scripts/stage-films.sh.
# Tracked once, as plugin/skills/mitate/examples/ — not twice. A pattern rather
# than a list, so a sixth example needs no edit here.
films/*.html

# NO exceptions, as of 0.16.35. gearbox-neon.html was the one negated file — a
# showcase-only neon variant — and was untracked on the owner's call: it was 66%
# of the site's tracked bytes for a variant the site does not need. If it returns,
# stage-films.sh should GENERATE it from gearbox.html plus the neon bible rather
# than storing a second 1.14 MB copy, which is what bibles.md claims is possible.
