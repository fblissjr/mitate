# macOS
.DS_Store
.AppleDouble
.LSOverride

# internal only folders — everything EXCEPT the session logs, which are tracked
# as of 2026-08-01 (owner's call). See CLAUDE.md's Conventions.
#
# `internal/*` and not `internal/`, deliberately: git does not descend into an
# excluded DIRECTORY, so `internal/` followed by `!internal/log/` re-includes
# nothing and fails silently — the logs would stay untracked while this file
# looked like it tracked them. Excluding the children instead leaves the parent
# traversable so the negation can take effect.
#
# The negation is deliberately narrow. internal/ still holds the local prototype fixture,
# the prior-artifacts tree, third-party correspondence and scratch renders, and NONE of that
# is tracked. Widening this pattern publishes them; add a new negated line for a
# specific path instead.
internal/*
!internal/log/

# Archived
.archive/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Node / bun (the skill's render + build toolchain, when it lands here)
node_modules/
.bun/
npm-debug.log*
bun-debug.log*
# bun.lock IS committed for reproducibility — do not ignore it.

# Playwright browsers / recorder scratch (never committed; artifacts live outside the repo)
.cache/ms-playwright/
/render-tmp/

# Machine-local tooling config (holds absolute paths — never commit)
.path-privacy.local.json

# The local flavor of the Claude Code settings. `.claude/settings.json` IS
# tracked and stays that way — it wires the claims reminder, which is a repo
# control and has to exist for every checkout. This file is its opposite half:
# per-machine skill overrides and permissions, one `git add -A` from a commit.
# It was ignored only by a global gitignore until now, so the guarantee held on
# one machine and nowhere else.
.claude/settings.local.json

# Env / secrets
.env
.env.local
.env.*.local

# Netlify
.netlify/

# Logs / OS cruft
*.log
Thumbs.db

# Transient bracket workspaces. bracket-commands.js mkdtemps these into cwd and
# removes them in a finally -- this is the belt for the path where it cannot,
# because scratch in the repo root is one `git add -A` from a commit.
.mitate-cmd-*/
